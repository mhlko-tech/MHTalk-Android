# Public client identifiers. These are compiled into the APK and must never be
# treated as authorization; backend rules and authenticated APIs enforce access.
MHTALK_SUPABASE_URL=https://your-project.supabase.co
MHTALK_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
MHTALK_FIREBASE_PROJECT_ID=your-project-id
MHTALK_FIREBASE_APP_ID=your-public-app-id
MHTALK_FIREBASE_API_KEY=your-public-firebase-api-key
MHTALK_FIREBASE_SENDER_ID=your-public-sender-id

# Release signing secrets. Keep values in GitHub Secrets or a local ignored
# secret store; never place real values in this file.
MHTALK_ANDROID_KEYSTORE=
MHTALK_ANDROID_STORE_PASSWORD=
MHTALK_ANDROID_KEY_ALIAS=
MHTALK_ANDROID_KEY_PASSWORD=
